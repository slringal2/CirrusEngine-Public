+    float column = smoothstep(0.38, 0.81, depth) * smoothstep(0.10, 0.39, coverage);
+    float middle = smoothstep(0.03, 0.20, localHeight) * (1 - smoothstep(0.52, 0.88, localHeight));
+    return 0.52 * convection * column * middle;
